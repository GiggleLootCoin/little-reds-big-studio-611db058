{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://zynkoruikdatkuxryvhf.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "little-reds-big-studio",
      "version": "1.0.0",
      "title": "Little Red's Big Studio"
    },
    "tools": [
      {
        "name": "list_my_sessions",
        "title": "List my studio sessions",
        "description": "List the signed-in creator's Little Red's Big Studio sessions (projects), newest first, with their titles and which assets they already contain.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_session",
        "title": "Get a studio session",
        "description": "Read one of the signed-in creator's studio sessions in full: lyrics, AI critique, storyboard and YouTube SEO metadata.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "format": "uuid",
              "description": "The session id from list_my_sessions."
            }
          },
          "required": [
            "session_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "save_session",
        "title": "Create or update a studio session",
        "description": "Create a new studio session, or update an existing one, for the signed-in creator. Use it to save lyrics, a critique or a storyboard written with the assistant so they appear in the studio app.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "session_id": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Existing session id to update, or null to create a new session."
            },
            "title": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ],
              "description": "Session title, or null to leave unchanged."
            },
            "lyrics": {
              "type": [
                "string",
                "null"
              ],
              "description": "Full lyrics text, or null to leave unchanged."
            },
            "critique": {
              "type": [
                "string",
                "null"
              ],
              "description": "Song critique text, or null to leave unchanged."
            },
            "storyboard": {
              "type": [
                "string",
                "null"
              ],
              "description": "Scene-by-scene storyboard text, or null to leave unchanged."
            }
          },
          "required": [
            "session_id",
            "title",
            "lyrics",
            "critique",
            "storyboard"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_my_profile",
        "title": "Get my creator profile",
        "description": "Read the signed-in creator's Little Red's Big Studio profile: handle, display name, about text and follower count.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_spotlight_tracks",
        "title": "List Artist Spotlight tracks",
        "description": "List the most recent tracks shared to the public Artist Spotlight community feed, with their creator handle and love/comment counts.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 50
                },
                {
                  "type": "null"
                }
              ],
              "description": "How many tracks to return (default 12)."
            }
          },
          "required": [
            "limit"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
